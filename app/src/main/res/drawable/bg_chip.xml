<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33D4AF37">
    <item>
        <selector>
            <item android:state_focused="true"><shape><solid android:color="#26D4AF37"/><stroke android:width="2dp" android:color="#D4AF37"/><corners android:radius="19dp"/></shape></item>
            <item android:state_selected="true"><shape><gradient android:angle="270" android:startColor="#E8CB62" android:endColor="#C9A227"/><corners android:radius="19dp"/></shape></item>
            <item><shape><solid android:color="#15151D"/><stroke android:width="1dp" android:color="#262633"/><corners android:radius="19dp"/></shape></item>
        </selector>
    </item>
    <item android:id="@android:id/mask"><shape><solid android:color="#FFFFFF"/><corners android:radius="19dp"/></shape></item>
</ripple>
