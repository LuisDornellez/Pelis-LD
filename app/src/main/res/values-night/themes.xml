<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PelisLD" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/netflix_red</item>
        <item name="colorPrimaryVariant">@color/netflix_red_dark</item>
        <item name="colorOnPrimary">#0B0B10</item>
        <item name="colorSecondary">@color/netflix_red</item>
        <item name="colorSecondaryVariant">@color/netflix_red_dark</item>
        <item name="colorOnSecondary">#0B0B10</item>
        <item name="colorSurface">@color/netflix_gray</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>
        <item name="android:colorBackground">@color/netflix_black</item>
        <item name="android:windowBackground">@color/netflix_black</item>
        <item name="android:statusBarColor">@color/netflix_black</item>
        <item name="android:navigationBarColor">@color/netflix_black</item>
        <item name="alertDialogTheme">@style/PelisDialog</item>
    </style>

    <style name="PelisDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#B4B4C0</item>
        <item name="buttonBarPositiveButtonStyle">@style/PelisDialogBtn</item>
        <item name="buttonBarNegativeButtonStyle">@style/PelisDialogBtn</item>
        <item name="buttonBarNeutralButtonStyle">@style/PelisDialogBtn</item>
    </style>

    <style name="PelisDialogBtn" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
</resources>
